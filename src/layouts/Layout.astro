---
import '@fontsource/jetbrains-mono';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Andrew Whatling Portfolio</title>
	</head>
	<body>
		<header>
			<h1>Andrew Whatling | Houdini TD </h1>
			<nav>
				<ul>
					<li><a href="/">Home</a></li>
					<li><a href="/#aboutMe">About Me</a></li>
                    <li><a href="/#projects">Projects</a></li>
                    <li><a href="https://www.linkedin.com/in/andrew-whatling-2704a6259/"
                           target="_blank"
                           rel="noopener noreferrer">Linkedin</a></li>
                    <li><a href="https://github.com/AndrewWhatling"
                           target="_blank"
                           rel="noopener noreferrer">Github</a></li>
				</ul>
			</nav>
		</header>
		<main>
			<slot />
		</main>
	</body>
</html>

<style>
	body {
        margin: 0;
        background-color: #222;
	}
	header {
        /*background-color: #f9f6fc;*/
        background-color: #222;
		padding: 10px 20px;
		display: flex;
		align-items: center;
		justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 1000;

		h1 {
			margin: 0;
		}
		ul {
			display: flex;
			list-style-type: none;
			gap: 16px;
		}
		a {
			text-decoration: none;
			border-bottom: 1px dashed;
		}
	}
</style>

<style is:global>
    
    html {
        scroll-behavior: smooth;
    }

    * {
		font-family: "JetBrains Mono", sans-serif;
        color: #ddd;
    }

	.content {
		width: 100%;
		/*max-width: 1200px;*/
		margin: 60px auto;
		padding: 0 20px;
		box-sizing: border-box;

		h1 {
			font-size: 2.5em;
		}
		p {
			font-size: 1.2em;
		}
	}
</style>


