---
import Layout from "../layouts/Layout.astro"
import ShowreelScroller from "../components/ShowreelScroller.astro"
import FeatureSection from "../components/FeatureSection.astro";
import AboutMe from "../components/AboutMe.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
---

<Layout>
    <ShowreelScroller />
    <AboutMe
    imageSrc="/media/pfp.png"
    imageAlt="Pfp"
    title="About Me"
    text={`
    <p>
    Hi there, I'm Andrew - a Houdini TD and programmer, and a recent graduate of the 3D Animation and VFX course at the 
    University of Hertfordshire.
    </p>

    <p>
    I'm passionate about developing tools, pipelines, and rendering solutions that make artists' lives easier. 
    I enjoy solving technical challenges behind the scenes, whether that's automating repetitive workflows, building
    production-ready tools, or improving rendering performance. My goal is to enable artists to do what they do best,
    while minimising the friction they experience with the tools and software they use every day. 
    </p>

    <p>
    My primary DCC is Houdini, and I'm also experienced with Nuke and Maya. I work primarily in Python and VEX and 
    am currently expanding my knowledge of C++. My interests include software development, pipeline creation, USD 
    workflows, rendering technology, performance optimisation and building reliable tools to improve production workflows.
    </p>

    <p>
    Outside of VFX, I enjoy exploring new technologies, experimenting with small coding projects, customising my linux 
    setup, listening to music, going to the gym and spending time with my friends and colleagues. I'm naturally curious
    and enjoy learning new things, whether that's researching a new topic or building something just for the sake of 
    understanding how it works.
    </p>

    <p>
    I am currently looking for TD roles in pipeline, lighting and R&D.
    </p>
    `}
   
    imageLeft={false}
    />

    <ProjectGrid />

</Layout>
