---
const items = [
  {
    type: "video",
    src: "/media/Anomaly_CG.mp4",
  },
  {
    type: "image",
    src: "/media/projects/helix/renders/hero_render.png",
  },
  {
    type: "video",
    src: "/media/Eye_To_Eye_CG.mp4",
    },
  {
    type: "video",
    src: "/media/JetpackSquirrel_Low.mp4",
  },
];

// duplicate items for seamless looping
const scrollingItems = [...items, ...items];
---

<div class="scroller">

  <div class="global-overlay">
    <a href="#" class="side-btn center" id="showreel-btn">
      Showreel
    </a>

  </div>

  <div class="track">
    {
      scrollingItems.map((item) => (
        <div class="media-item">
          {
            item.type === "video" ? (
              <video
                src={item.src}
                autoplay
                muted
                loop
                playsinline
              />
            ) : (
              <img src={item.src} alt="" />
            )
          }
        </div>
      ))
    }
  </div>
</div>


<div class="video-modal" id="showreel-modal">
  <div class="modal-backdrop"></div>

  <div class="modal-content">
    <button class="close-btn" aria-label="Close">
      &times;
    </button>

    <video
      id="showreel-video"
      src="/media/Showreel.mp4"
      controls
      playsinline
    ></video>
  </div>
</div>


<style>
    .scroller {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: black;
    padding: 12px;
  }
    
  .scroller:has(:hover) .track {
    filter: blur(6px);
    opacity: 0.5;
    transform: scale(0.98);

    transition:
      filter 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.8s ease;
  }

  .track {
    display: flex;
    width: max-content;
    animation: scroll 40s linear infinite;
    gap: 12px;
  }

  .media-item {
    flex-shrink: 0;
    width: 600px;
    height: 340px;
    border-radius: 12px;
    overflow: hidden;
    background: #111;

    transition:
      filter 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.45s ease;
  }

  .media-item video,
  .media-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* overlay layer */
  .global-overlay {
    position: absolute;
    inset: 0;

    display: flex;
    justify-content: center;
    align-items: center;
    gap: 200px;

    pointer-events: none;

    opacity: 0;
    transition: opacity 0.35s ease;

    z-index: 50;
  }

  /* show overlay on hover */
  .scroller:hover .global-overlay {
    opacity: 1;
  }

  /* buttons */
  .side-btn {
    pointer-events: auto;

    color: white;
    text-decoration: none;

    padding: 14px 28px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.5);

    background: rgba(0,0,0,0.45);

    backdrop-filter: blur(12px);

    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;

  }

  .side-btn:hover {
    transform: scale(1.1);
    background: rgba(255,255,255,0.2);
  }


  @keyframes scroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }


  .video-modal {
      position: fixed;
      inset: 0;

      display: none;

      justify-content: center;
      align-items: center;

      background: rgba(0,0,0,.0015);
      backdrop-filter: blur(12px);

      z-index: 99999;
  }

  .video-modal.open {
      display: flex;
  }  

    .modal-backdrop {
      position: absolute;
      inset: 0;

      background: rgba(0, 0, 0, 0.82);
      backdrop-filter: blur(10px);
  }

  .modal-content {
      position: relative;

      width: min(92vw, 1200px);

      transform: scale(0.92);
      opacity: 0;

      transition:
          transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.45s ease;

      z-index: 2;
  }

  .video-modal.open .modal-content {
      transform: scale(1);
      opacity: 1;
  }

  .modal-content video {
      width: 100%;
      display: block;

      border-radius: 12px;
      background: black;
  }

  .close-btn {
      position: absolute;
      top: -48px;
      right: 0;

      width: 40px;
      height: 40px;

      border: none;
      border-radius: 50%;

      background: rgba(255,255,255,0.15);
      color: white;

      cursor: pointer;

      font-size: 28px;
      line-height: 1;

      backdrop-filter: blur(8px);
  }

  .close-btn:hover {
      background: rgba(255,255,255,0.3);
  }


</style>


<script>
  const modal = document.getElementById("showreel-modal");
  const button = document.getElementById("showreel-btn");
  const close = modal.querySelector(".close-btn");
  const backdrop = modal.querySelector(".modal-backdrop");
  const video = document.getElementById("showreel-video");

  function openModal(e) {
    e.preventDefault();
    modal.classList.add("open");
    video.currentTime = 0;
    video.play();
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    modal.classList.remove("open");
    video.pause();
    document.body.style.overflow = "";
  }

  button.addEventListener("click", openModal);
  close.addEventListener("click", closeModal);
  backdrop.addEventListener("click", closeModal);

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeModal();
    }
  });
</script>
