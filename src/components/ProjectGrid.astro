---
import ProjectCard from "./ProjectCard.astro";

const projects = [
    {
        title: "Helix",
        imageSrc: "/media/projects/helix/renders/hero_render.png",
        href: "/projects/Helix"
    },
    {
        title: "Bushtail Bandit",
        imageSrc: "/media/JetpackSquirrel_Hero.png",
        href: "/projects/BushtailBandit"
    },
    {
        title: "Point Deform Procedural",
        imageSrc: "/media/projects/pointdeformprocedural/pointdeformprocedural_hero.png",
        href: "/projects/PointDeformProcedural"
    },
    {
        title: "Usd Exporter",
        imageSrc: "/media/projects/usdexporter/usdexporter_hero.png",
        href: "/projects/UsdExporter"
    },
    {
        title: "Eye To Eye",
        imageSrc: "/media/Eye_To_Eye_Hero.png",
        href: "/projects/EyeToEye"
    },
    {
        title: "Auto Slapcomper",
        imageSrc: "/media/projects/slapcomp/slapcomp_hero.png",
        href: "/projects/PdgSlapcomp"
    },
    {
        title: "Subdivision Curvature",
        imageSrc: "/media/projects/curvature/curvature_hero.png",
        href: "/projects/SubdivisionCurvature"
    },
    {
        title: "Anomaly",
        imageSrc: "/media/Anomaly_Hero.png",
        href: "/projects/Anomaly"
    }
];
---

<section id="projects" class="projects">
    {projects.map(project => (
        <ProjectCard
            title={project.title}
            imageSrc={project.imageSrc}
            href={project.href}
        />
    ))}
</section>

<style>
.projects {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    padding: 4rem;
}

@media (max-width: 1024px) {
    .projects {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 640px) {
    .projects {
        grid-template-columns: 1fr;
    }
}
</style>
