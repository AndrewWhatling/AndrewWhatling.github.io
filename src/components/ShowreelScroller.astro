---
const items = [
  {
    type: "video",
    src: "/media/Whatling_Andrew_Lighting_Showreel_05_2026_v002.mp4",
  },
  {
    type: "image",
    src: "/media/test_02.jpg",
  },
  {
    type: "image",
    src: "/media/test_01.jpg",
  },
  {
    type: "image",
    src: "/media/test_03.jpg",
  },
];

// duplicate items for seamless looping
const scrollingItems = [...items, ...items];
---

<div class="scroller">

  <div class="global-overlay">
    <a href="/showreel" class="side-btn left">
      Showreel
    </a>

    <a href="/tech-reel" class="side-btn right">
      Tech Reel
    </a>
  </div>

  <div class="track">
    {
      scrollingItems.map((item) => (
        <div class="media-item">
          {
            item.type === "video" ? (
              <video
                src={item.src}
                autoplay
                muted
                loop
                playsinline
              />
            ) : (
              <img src={item.src} alt="" />
            )
          }
        </div>
      ))
    }
  </div>
</div>

<style>
    .scroller {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: black;
    padding: 12px;
  }
    
  .scroller:has(:hover) .track {
    filter: blur(6px);
    opacity: 0.5;
    transform: scale(0.98);

    transition:
      filter 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.8s ease;
  }

  .track {
    display: flex;
    width: max-content;
    animation: scroll 40s linear infinite;
    gap: 12px;
  }

  .media-item {
    flex-shrink: 0;
    width: 600px;
    height: 340px;
    border-radius: 12px;
    overflow: hidden;
    background: #111;

    transition:
      filter 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.45s ease;
  }

  .media-item video,
  .media-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* overlay layer */
  .global-overlay {
    position: absolute;
    inset: 0;

    display: flex;
    justify-content: center;
    align-items: center;
    gap: 200px;

    pointer-events: none;

    opacity: 0;
    transition: opacity 0.35s ease;

    z-index: 50;
  }

  /* show overlay on hover */
  .scroller:hover .global-overlay {
    opacity: 1;
  }

  /* buttons */
  .side-btn {
    pointer-events: auto;

    color: white;
    text-decoration: none;

    padding: 14px 28px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.5);

    background: rgba(0,0,0,0.45);

    backdrop-filter: blur(12px);

    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;

  }

  .side-btn:hover {
    transform: scale(1.1);
    background: rgba(255,255,255,0.2);
  }


  @keyframes scroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }
</style>
