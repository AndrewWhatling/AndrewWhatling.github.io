---
interface Props {
    title: string;
    imageSrc: string;
    href: string;
}

const { title, imageSrc, href } = Astro.props;
---

<a href={href} class="card">
    <img src={imageSrc} alt={title} />

    <div class="overlay">
        <h3>{title}</h3>
    </div>
</a>

<style>
.card {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    aspect-ratio: 16 / 9;
    display: block;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0,0,0,.6);
}

.card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: 0.3s ease;
}

.overlay {
    position: absolute;
    inset: 0;

    display: flex;
    justify-content: center;
    align-items: center;

    background: rgba(0, 0, 0, 0.18);

    opacity: 0;
    transition: opacity 0.3s ease;
}

.overlay h3 {
    color: white;
    margin: 0;
}

.card:hover img {
    filter: blur(6px);
    opacity: 0.5;
    transform: scale(0.98);

    transition:
      filter 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.8s ease;
    transform: scale(1.05);
}

.card:hover .overlay {
    opacity: 1;
}
</style>
